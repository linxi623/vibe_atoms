# Copy this file to .env on the server and replace every placeholder.
# Use only letters and numbers for POSTGRES_PASSWORD so DATABASE_URL stays valid.
POSTGRES_DB=vibe_atoms
POSTGRES_USER=vibe
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password

APP_ORIGIN=https://demo.linxi123.top
MODEL_BASE_URL=https://your-model-provider.example/v1
MODEL_NAME=replace_with_model_name
MODEL_API_KEY=replace_with_server_side_model_key
IP_HASH_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Optional safety limits. Defaults are suitable for a small demo.
# MODEL_TASK_TOKEN_BUDGET=25000
# LIMIT_TOTAL_TASKS=200
# LIMIT_GLOBAL_CONCURRENCY=2
